<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D0F"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="ÉDITEUR PDF INTELLIGENT"
        android:textColor="#FFF1D7"
        android:textSize="21sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnChoosePdf"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_orange"
        android:backgroundTint="@null"
        android:text="PDF  •  CHOISIR UN DOCUMENT OFFICIEL"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_card_accent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvChatGptStatus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:text="ChatGPT : aucun PDF synchronisé"
            android:textColor="#FFF1D7"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenChatGpt"
            android:layout_width="76dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_orange"
            android:backgroundTint="@null"
            android:text="OUVRIR"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMcpSync"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_orange"
            android:backgroundTint="@null"
            android:contentDescription="Relancer la synchronisation ChatGPT"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMcpLogs"
            android:layout_width="54dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_dark"
            android:backgroundTint="@null"
            android:text="LOGS"
            android:textColor="#FFE1A8"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp">

        <Button
            android:id="@+id/btnPrevPage"
            android:layout_width="68dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_dark"
            android:backgroundTint="@null"
            android:text="‹ PAGE"
            android:textColor="#FFE1A8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Aucun PDF"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNextPage"
            android:layout_width="68dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_dark"
            android:backgroundTint="@null"
            android:text="PAGE ›"
            android:textColor="#FFE1A8"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp">

        <Button
            android:id="@+id/btnDetectFields"
            android:layout_width="92dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_orange"
            android:backgroundTint="@null"
            android:text="REPÈRES"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPrevField"
            android:layout_width="42dp"
            android:layout_height="38dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/bg_button_dark"
            android:backgroundTint="@null"
            android:text="‹"
            android:textColor="#FFE1A8"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvFieldStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Visuel direct"
            android:textColor="#FF9A5C"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNextField"
            android:layout_width="42dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_dark"
            android:backgroundTint="@null"
            android:text="›"
            android:textColor="#FFE1A8"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnResetZoom"
            android:layout_width="62dp"
            android:layout_height="38dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/bg_button_dark"
            android:backgroundTint="@null"
            android:text="100%"
            android:textColor="#B9C9FF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_card"
        android:padding="5dp">

        <com.chasmet.remplissagepapierofficiel.PdfOverlayView
            android:id="@+id/pdfView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E8E8E5" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvPosition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Pincez pour zoomer • glissez pour déplacer • touchez une zone à remplir."
        android:textColor="#B8BEC1"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etOverlayText"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_input"
        android:hint="Texte à inscrire dans le champ sélectionné"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHighlight="#FF6500"
        android:textColorHint="#737A7E" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddText"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_button_orange"
                android:backgroundTint="@null"
                android:text="＋ AJOUTER"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="↶ ANNULER"
                android:textColor="#FFB58A" />

            <Button
                android:id="@+id/btnUseFirstName"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="Prénom"
                android:textColor="#FFE1A8" />

            <Button
                android:id="@+id/btnUseLastName"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="Nom"
                android:textColor="#FFE1A8" />

            <Button
                android:id="@+id/btnUseName"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="Nom complet"
                android:textColor="#FFE1A8" />

            <Button
                android:id="@+id/btnUseBirthDate"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="Naissance"
                android:textColor="#FFE1A8" />

            <Button
                android:id="@+id/btnUseToday"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="Date du jour"
                android:textColor="#FFE1A8" />

            <Button
                android:id="@+id/btnUseAddress"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="Adresse"
                android:textColor="#FFE1A8" />

            <Button
                android:id="@+id/btnUsePhone"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="Téléphone"
                android:textColor="#FFE1A8" />

            <Button
                android:id="@+id/btnUseEmail"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="E-mail"
                android:textColor="#FFE1A8" />

            <Button
                android:id="@+id/btnTextSmaller"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="A−"
                android:textColor="#B9C9FF" />

            <TextView
                android:id="@+id/tvTextSize"
                android:layout_width="48dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="14"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTextLarger"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="A+"
                android:textColor="#B9C9FF" />

            <Button
                android:id="@+id/btnClearPage"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="EFFACER PAGE"
                android:textColor="#FF9A75" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnExportPdf"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_orange"
            android:backgroundTint="@null"
            android:text="EXPORTER PDF"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Space
            android:layout_width="7dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnExportPng"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_dark"
            android:backgroundTint="@null"
            android:text="EXPORTER PNG"
            android:textColor="#FFE1A8"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
