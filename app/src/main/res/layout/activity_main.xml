<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:contentDescription="Logo Remplissage papier officiel"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_app" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="REMPLISSAGE\nPAPIER OFFICIEL"
            android:textColor="#FFF1D7"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Remplir. Préparer. Imprimer."
            android:textColor="#C9CDCF"
            android:textSize="16sp" />

        <View
            android:layout_width="52dp"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:background="#FF5A00" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNewDocument"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_accent"
                android:backgroundTint="@null"
                android:gravity="center"
                android:text="＋\nNOUVEAU\nDOCUMENT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Space android:layout_width="12dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/btnImportPdf"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:backgroundTint="@null"
                android:gravity="center"
                android:text="PDF\nIMPORTER\nUN PDF"
                android:textColor="#FFE1A8"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDocuments"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:backgroundTint="@null"
                android:gravity="center"
                android:text="▣\nMES\nDOCUMENTS"
                android:textColor="#FFE1A8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Space android:layout_width="12dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:backgroundTint="@null"
                android:gravity="center"
                android:text="●\nPROFIL"
                android:textColor="#FFE1A8"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_dark"
            android:backgroundTint="@null"
            android:text="⚙  RÉGLAGES & MISES À JOUR"
            android:textColor="#FF8A3D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:text="✓  Documents et profil conservés localement sur le téléphone"
            android:textColor="#C9CDCF"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
