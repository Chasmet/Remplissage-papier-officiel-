<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DIAGNOSTIC CHATGPT / MCP"
            android:textColor="#FFF1D7"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBridgeDiagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRefreshLogs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_orange"
                android:backgroundTint="@null"
                android:text="ACTUALISER"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnCopyLogs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="COPIER"
                android:textColor="#FFE1A8"
                android:textStyle="bold" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnClearLogs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:text="VIDER"
                android:textColor="#FF9A75"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="JOURNAL TECHNIQUE"
            android:textColor="#FF8A3D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:minHeight="320dp"
            android:padding="12dp"
            android:textColor="#D6DADB"
            android:textIsSelectable="true"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
